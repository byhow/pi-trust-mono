{
  "name": "@byhow/pi-model-picker",
  "version": "0.1.0",
  "description": "Pi/OMP adapter for the canonical model-picker selection contract.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./extension": "./src/extension.ts"
  },
  "files": [
    "src/extension.ts",
    "src/index.ts",
    "src/process.ts",
    "src/runner.ts",
    "src/selector.ts",
    "src/types.ts",
    "contracts/model-picker.selection.v1.schema.json",
    "contracts/model-picker.selection.v1.fixture.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "byhow",
  "repository": {
    "type": "git",
    "url": "https://github.com/byhow/pi-trust-mono.git",
    "directory": "packages/pi-model-picker"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ai-models",
    "model-picker",
    "pi-package"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "hostConformance": {
    "commands": [
      "model-picker"
    ],
    "tools": [
      "model_picker"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@oh-my-pi/pi-coding-agent": "17.4.1 || 18.1.4"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
