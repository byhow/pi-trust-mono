{
  "name": "pi-warm-memory",
  "version": "0.1.0",
  "description": "Cross-session episodic memory for pi agents: /archive-session handoff & checkpoint packets with a searchable append-only index.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "memory",
    "agent"
  ],
  "license": "MIT",
  "author": "byhow",
  "repository": {
    "type": "git",
    "url": "https://github.com/byhow/pi-trust-mono.git",
    "directory": "packages/pi-warm-memory"
  },
  "files": [
    "src/index.ts",
    "src/git-context.ts",
    "src/packets.ts",
    "src/paths.ts",
    "src/host.ts",
    "src/prompt-frame.ts",
    "src/storage.ts",
    "src/text-safety.ts",
    "src/commands/archive-core.ts",
    "src/commands/recall-core.ts",
    "src/search/corpus.ts",
    "src/search/persistence.ts",
    "templates",
    "rules",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@oh-my-pi/pi-coding-agent": "17.4.1 || 18.0.3"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "typebox": "1.3.7"
  }
}
