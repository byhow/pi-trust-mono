{
  "name": "pi-sisyphus",
  "version": "0.1.0",
  "description": "Fail-closed Pi/OMP adapter for Sisyphus Trust Decisions and MCP Vet Evidence.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./extension": "./src/extension.ts"
  },
  "files": [
    "src/engine.ts",
    "src/extension.ts",
    "src/index.ts",
    "src/mcp.ts",
    "src/process.ts",
    "src/resource-scope.ts",
    "src/types.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "byhow",
  "repository": {
    "type": "git",
    "url": "https://github.com/byhow/pi-trust-mono.git",
    "directory": "packages/pi-sisyphus"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "authorization",
    "mcp",
    "pi-package",
    "policy",
    "sisyphus"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "hostConformance": {
    "commands": [
      "mcp-vet",
      "permit"
    ],
    "tools": [
      "mcp_vet",
      "sisyphus_policy"
    ],
    "events": [
      "tool_call"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@oh-my-pi/pi-coding-agent": "17.4.1 || 18.1.4"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
