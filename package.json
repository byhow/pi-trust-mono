{
  "name": "pi-trust-mono",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run verify:lockfile && npm run verify:packages && npm run verify:pack && npm run lint && npm run typecheck && npm run test:coverage",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "verify:lockfile": "node scripts/verify-public-lockfile.mjs",
    "verify:packages": "node scripts/verify-package-contracts.mjs",
    "verify:pack": "node scripts/verify-packed-packages.mjs",
    "verify:host": "node scripts/verify-host-matrix.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.0"
  }
}
